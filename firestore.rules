rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validProduct() {
      return request.resource.data.keys().hasOnly([
          'name', 'price', 'description', 'category', 'image', 'details', 'specifications'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 120
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.description is string
        && request.resource.data.description.size() < 300
        && request.resource.data.category is string
        && request.resource.data.image is string
        && request.resource.data.image.size() < 200
        && request.resource.data.details is string
        && request.resource.data.details.size() < 600
        && request.resource.data.specifications is list
        && request.resource.data.specifications.size() <= 8;
    }

    function validCartItem() {
      return request.resource.data.keys().hasOnly(['name', 'price', 'quantity'])
        && request.resource.data.name is string
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update: if signedIn() && validProduct();
      allow delete: if signedIn();
    }

    match /carts/{userId}/items/{itemId} {
      allow read, delete: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && validCartItem();
    }
  }
}
